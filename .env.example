# OpenAI API key (or key for another OpenAI-compatible provider)
OPENAI_API_KEY=your_api_key_here

# Optional overrides:
# SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_BASE_URL=https://api.openai.com/v1
# SUMMARY_LANGUAGE=English  # e.g. English, Ukrainian, etc.
# SUMMARY_DISPLAY=true      # Set to false to suppress console display by default

# Optional yt-dlp cookie authentication (if YouTube blocks with "Sign in to confirm you're not a bot"):
# YTDLP_COOKIES_FROM_BROWSER=firefox  # or chrome, brave, etc.
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
